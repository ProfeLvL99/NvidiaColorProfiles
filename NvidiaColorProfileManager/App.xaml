<Application x:Class="NvidiaColorProfileManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:converters="clr-namespace:NvidiaColorProfileManager.Converters"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources />
                <ui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
            <converters:ProfileActiveConverter x:Key="ProfileActive" />

            <!-- NVIDIA Accent Color Overrides -->
            <SolidColorBrush x:Key="NvidiaGreen" Color="#76B900"/>
            <SolidColorBrush x:Key="NvidiaGreenDark" Color="#5A8F00"/>
            <SolidColorBrush x:Key="NvidiaBgDeep" Color="#0D0D0D"/>
            <SolidColorBrush x:Key="NvidiaBgCard" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="NvidiaBgControl" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="NvidiaBgControlHover" Color="#2A2A2A"/>

            <!-- ToggleSwitch visible OFF state -->
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#3A3A3A"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#555555"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#666666"/>
            <SolidColorBrush x:Key="ToggleSwitchContainerBackground" Color="Transparent"/>
            <!-- ToggleSwitch hover OFF state -->
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#4A4A4A"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#666666"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#777777"/>
            <SolidColorBrush x:Key="ToggleSwitchContainerBackgroundPointerOver" Color="Transparent"/>
            <!-- ToggleSwitch pressed OFF state -->
            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#353535"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#505050"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#606060"/>
            <SolidColorBrush x:Key="ToggleSwitchContainerBackgroundPressed" Color="Transparent"/>
            <!-- ToggleSwitch ON state (lime green) -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#76B900"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#5A8F00"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#8CCE00"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#6AA800"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#5A8F00"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#3D6600"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#E0E0E0"/>
            <!-- Slider lime green -->
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#76B900"/>
            <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#3D6600"/>
            <SolidColorBrush x:Key="SliderTrackFill" Color="#3A3A3A"/>
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#76B900"/>
            <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#3D6600"/>
            <SolidColorBrush x:Key="NvidiaBorder" Color="#2A2A2A"/>
            <SolidColorBrush x:Key="NvidiaBorderControl" Color="#3A3A3A"/>
            <SolidColorBrush x:Key="NvidiaTextPrimary" Color="#E8E8E8"/>
            <SolidColorBrush x:Key="NvidiaTextSecondary" Color="#999999"/>
            <SolidColorBrush x:Key="NvidiaTextMuted" Color="#888888"/>

            <!-- NVIDIA Button Styles -->
            <Style x:Key="NvidiaAccentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#1E1E1E"/>
                <Setter Property="Foreground" Value="#76B900"/>
                <Setter Property="BorderBrush" Value="#76B900"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="16,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2A2A2A"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#151515"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NvidiaDarkButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#252525"/>
                <Setter Property="Foreground" Value="#CCCCCC"/>
                <Setter Property="BorderBrush" Value="#3A3A3A"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#333333"/>
                                    <Setter Property="BorderBrush" Value="#555555"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#1A1A1A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- NVIDIA ComboBox dark dropdown -->
            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="#1E1E1E"/>
                <Setter Property="Foreground" Value="#E0E0E0"/>
                <Setter Property="BorderBrush" Value="#3A3A3A"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Background" Value="#1E1E1E"/>
                <Setter Property="Foreground" Value="#E0E0E0"/>
            </Style>

            <!-- Title bar button colors -->
            <SolidColorBrush x:Key="WindowCaptionForeground" Color="#76B900"/>
            <SolidColorBrush x:Key="WindowCaptionButtonBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="WindowCaptionButtonBackgroundPointerOver" Color="#2A2A2A"/>
            <SolidColorBrush x:Key="WindowCaptionButtonBackgroundPressed" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="WindowCaptionButtonStroke" Color="Transparent"/>
            <SolidColorBrush x:Key="WindowCaptionButtonStrokePointerOver" Color="#3A3A3A"/>
            <SolidColorBrush x:Key="WindowCloseButtonForeground" Color="#76B900"/>
            <SolidColorBrush x:Key="WindowCloseButtonBackgroundPointerOver" Color="#C42B1C"/>
            <SolidColorBrush x:Key="WindowCloseButtonForegroundPointerOver" Color="#FFFFFF"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
