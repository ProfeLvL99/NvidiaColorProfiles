<Window x:Class="NvidiaColorProfileManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:controls="clr-namespace:NvidiaColorProfileManager.Views.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Foreground="#CCCCCC"
        Title="NVIDIA Color Profiles"
        Width="960" Height="640"
        Icon="Resources/Icons/app.ico"
        MinWidth="860" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D"
        WindowStyle="None"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated"
        StateChanged="Window_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0" CornerRadius="8"
                            CaptionHeight="36" ResizeBorderThickness="4"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ CUSTOM TITLE BAR ═══ -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Background="#2D2D2D"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Icon + Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0">
                <Image Source="Resources/Icons/app.ico" Width="18" Height="18"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="NVIDIA Color Profiles" FontSize="13"
                           FontWeight="SemiBold" Foreground="#76B900"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Window buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeBtn" Content="─" Width="46" Height="36"
                        FontSize="14" Foreground="#888888"
                        Click="MinimizeBtn_Click"
                        Style="{StaticResource TitleBarButtonStyle}"/>
                <Button x:Name="MaximizeBtn" Content="□" Width="46" Height="36"
                        FontSize="12" Foreground="#888888"
                        Click="MaximizeBtn_Click"
                        Style="{StaticResource TitleBarButtonStyle}"/>
                <Button x:Name="CloseBtn" Content="✕" Width="46" Height="36"
                        FontSize="13" Foreground="#888888"
                        Click="CloseBtn_Click"
                        Style="{StaticResource TitleBarCloseButtonStyle}"/>
            </StackPanel>
        </Grid>

        <!-- ═══ MAIN CONTENT ═══ -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ LEFT: Profile Cards ═══ -->
            <Border Grid.Column="0" CornerRadius="10"
                    Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0" Text="Profiles" FontSize="15" FontWeight="SemiBold"
                               Foreground="#CCCCCC" Margin="14,12,12,6"/>

                    <!-- + New Profile Button -->
                    <Button Grid.Row="1" Content="+ New Profile"
                            Command="{Binding NewProfileCommand}"
                            Style="{StaticResource NvidiaAccentButtonStyle}"
                            Height="38" Margin="12,0,12,10" FontSize="13"/>

                    <!-- Profile Cards -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  Background="Transparent">
                        <ItemsControl ItemsSource="{Binding Profiles}" Margin="8,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4,3" Padding="12,10" CornerRadius="8"
                                            Cursor="Hand"
                                            Background="#1E1E1E"
                                            BorderThickness="1"
                                            BorderBrush="#2E2E2E"
                                            MouseLeftButtonDown="ProfileCard_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Active check -->
                                            <TextBlock Grid.Column="0" Text="✓" FontSize="14" FontWeight="Bold"
                                                       Foreground="#76B900" VerticalAlignment="Center"
                                                       Margin="0,0,8,0">
                                                <TextBlock.Visibility>
                                                    <MultiBinding Converter="{StaticResource ProfileActive}">
                                                        <Binding Path="Id"/>
                                                        <Binding Path="DataContext.SelectedProfile.Id"
                                                                 RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </TextBlock.Visibility>
                                            </TextBlock>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#E0E0E0"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="11"
                                                           Foreground="#888888"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="🗑" Width="28" Height="28" FontSize="12"
                                                    ToolTip="Delete" Padding="0"
                                                    Click="DeleteProfileCard_Click"
                                                    Tag="{Binding}"
                                                    Style="{StaticResource NvidiaDarkButtonStyle}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          Background="Transparent"/>

            <!-- ═══ RIGHT: Editor ═══ -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          Background="Transparent">
                <StackPanel Margin="14,0,0,0">
                    <!-- Header row -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EditorTitle}" FontSize="20" FontWeight="SemiBold"
                                       Foreground="#E8E8E8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse Width="8" Height="8" Fill="#76B900" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding NvapiStatusText}" FontSize="12"
                                           Foreground="#76B900"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,0">
                            <Grid Margin="0,0,10,0" HorizontalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Start with Windows" FontSize="13"
                                           Foreground="#AAAAAA" Margin="0,0,0,3"/>
                                <ui:ToggleSwitch Grid.Row="1" IsOn="{Binding StartWithWindows}"
                                                 OffContent="" OnContent=""/>
                            </Grid>

                            <Button Content="⟳" Width="38" Height="38" FontSize="15"
                                    ToolTip="Refresh displays" Margin="0,0,4,0" Padding="0"
                                    Command="{Binding RefreshDisplaysCommand}"
                                    Style="{StaticResource NvidiaDarkButtonStyle}"/>
                            <Button Content="↺" Width="38" Height="38" FontSize="15"
                                    ToolTip="Restore defaults" Padding="0"
                                    Command="{Binding RestoreDefaultsCommand}"
                                    Style="{StaticResource NvidiaDarkButtonStyle}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Profile Name -->
                    <TextBlock Text="Profile Name" FontSize="12"
                               Foreground="#888888" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Padding="10,8" Margin="0,0,0,12"
                             Background="#1E1E1E" Foreground="#E0E0E0"
                             BorderBrush="#3A3A3A" BorderThickness="1"
                             CaretBrush="#76B900"
                             Style="{x:Null}">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <!-- Hotkey -->
                    <TextBlock Text="Keyboard Shortcut" FontSize="12"
                               Foreground="#888888" Margin="0,0,0,4"/>
                    <TextBox x:Name="HotkeyBox" Text="{Binding HotkeyDisplay, Mode=OneWay}"
                             IsReadOnly="True" FontSize="13" Padding="10,8" Margin="0,0,0,12"
                             Background="#1E1E1E" Foreground="#999999"
                             BorderBrush="#3A3A3A" BorderThickness="1"
                             Cursor="Hand"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                             MouseLeftButtonDown="HotkeyBox_Focus"
                             Style="{x:Null}">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <!-- Target Display -->
                    <TextBlock Text="Target Display" FontSize="12"
                               Foreground="#888888" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AvailableDisplays}"
                              SelectedItem="{Binding SelectedTargetDisplay}"
                              DisplayMemberPath="Name"
                              FontSize="13" Margin="0,0,0,12"
                              Background="#1E1E1E" Foreground="#E0E0E0"
                              BorderBrush="#3A3A3A" BorderThickness="1">
                        <ComboBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1E1E1E"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E0E0E0"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#76B900"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0D0D0D"/>
                        </ComboBox.Resources>
                        <ComboBox.Template>
                            <ControlTemplate TargetType="ComboBox">
                                <Grid>
                                    <ToggleButton x:Name="ToggleButton"
                                                  Background="{TemplateBinding Background}"
                                                  BorderBrush="{TemplateBinding BorderBrush}"
                                                  BorderThickness="{TemplateBinding BorderThickness}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press" Padding="10,6">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                                                        <Path Grid.Column="1" Data="M0,0 L5,5 L10,0" Stroke="#888888"
                                                              StrokeThickness="1.5" VerticalAlignment="Center"
                                                              Margin="8,0,0,0" Width="10" Height="5"
                                                              Stretch="Uniform"/>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <Popup x:Name="Popup"
                                           IsOpen="{TemplateBinding IsDropDownOpen}"
                                           Placement="Bottom"
                                           AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                        <Border x:Name="DropDownBorder"
                                                Background="#1E1E1E" BorderBrush="#3A3A3A"
                                                BorderThickness="1" CornerRadius="6"
                                                Margin="0,2,0,0">
                                            <ScrollViewer>
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </ControlTemplate>
                        </ComboBox.Template>
                    </ComboBox>

                    <!-- Color Sliders -->
                    <Border CornerRadius="10" Padding="16,12" Margin="0,0,0,12"
                            Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Color Settings" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"
                                       Foreground="#CCCCCC"/>
                            <controls:ColorSlider Header="Brightness" Unit="%" Minimum="0" Maximum="100"
                                                  Value="{Binding Brightness}"/>
                            <controls:ColorSlider Header="Contrast" Unit="%" Minimum="0" Maximum="100"
                                                  Value="{Binding Contrast}"/>
                            <controls:ColorSlider Header="Gamma" Unit="" Minimum="0.5" Maximum="3.0" TickFrequency="0.05"
                                                  Value="{Binding Gamma}"/>
                            <controls:ColorSlider Header="Vibrance" Unit="%" Minimum="0" Maximum="100"
                                                  Value="{Binding DigitalVibrance}"/>
                            <controls:ColorSlider Header="Color Temp" Unit="K" Minimum="-100" Maximum="100"
                                                  Value="{Binding ColorTemperature}"/>
                        </StackPanel>
                    </Border>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Read from Monitor"
                                Command="{Binding ReadFromMonitorCommand}"
                                Style="{StaticResource NvidiaDarkButtonStyle}"
                                Padding="14,8" Margin="0,0,8,0" FontSize="12"/>
                        <Button Content="Cancel"
                                Command="{Binding CancelEditCommand}"
                                Style="{StaticResource NvidiaDarkButtonStyle}"
                                Padding="14,8" Margin="0,0,8,0" FontSize="12"/>
                        <Button Content="Save Profile"
                                Command="{Binding SaveProfileCommand}"
                                Style="{StaticResource NvidiaAccentButtonStyle}"
                                Padding="18,8" FontSize="12"/>
                    </StackPanel>

                    <!-- Spacer -->
                    <Border Height="16"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Margin="12,0,12,8" Padding="12,8" CornerRadius="8"
                Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" VerticalAlignment="Center"
                           Foreground="#888888"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="by @ProfeLvL99" FontSize="11" Foreground="#666666"
                            VerticalAlignment="Center" Margin="0,0,8,0" Padding="0"
                            Cursor="Hand" Click="AuthorLink_Click"
                            Style="{StaticResource NvidiaLinkButtonStyle}"/>
                    <Button Content="♥" Width="32" Height="28" FontSize="14"
                            ToolTip="Donate" Padding="0" Margin="0,0,6,0"
                            Click="DonateButton_Click" Foreground="#76B900"
                            Style="{StaticResource NvidiaDarkButtonStyle}"/>
                    <Button Content="Exit" Height="28" Padding="14,0"
                            FontSize="12" Click="ExitButton_Click"
                            Style="{StaticResource NvidiaDarkButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
